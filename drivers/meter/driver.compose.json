{
  "id": "meter",
  "name": {
    "en": "Solplanet Grid Meter"
  },
  "class": "sensor",
  "platforms": ["local"],
  "connectivity": ["lan"],
  "capabilities": [
    "measure_power",
    "measure_power.home",
    "meter_power.imported",
    "meter_power.exported",
    "meter_power.imported_today",
    "meter_power.exported_today"
  ],
  "capabilitiesOptions": {
    "measure_power": { "title": { "en": "Grid power" } },
    "measure_power.home": { "title": { "en": "Home consumption" } },
    "meter_power.imported": { "title": { "en": "Imported" } },
    "meter_power.exported": { "title": { "en": "Exported" } },
    "meter_power.imported_today": { "title": { "en": "Imported today" } },
    "meter_power.exported_today": { "title": { "en": "Exported today" } }
  },
  "energy": {
    "cumulative": true,
    "cumulativeImportedCapability": "meter_power.imported",
    "cumulativeExportedCapability": "meter_power.exported"
  },
  "images": {
    "small": "/drivers/meter/assets/images/small.png",
    "large": "/drivers/meter/assets/images/large.png"
  },
  "pair": [
    { "id": "start" },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices" }
    },
    { "id": "add_devices", "template": "add_devices" }
  ],
  "repair": [
    { "id": "refresh" }
  ],
  "settings": [
    {
      "type": "group",
      "label": { "en": "Connection" },
      "children": [
        {
          "id": "ip_address",
          "type": "text",
          "label": { "en": "IP address" },
          "value": ""
        },
        {
          "id": "serial_number",
          "type": "text",
          "label": { "en": "Serial number" },
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": { "en": "Polling" },
      "children": [
        {
          "id": "poll_interval_seconds",
          "type": "number",
          "label": { "en": "Poll interval (seconds)" },
          "min": 5,
          "max": 300,
          "value": 60
        }
      ]
    },
    {
      "type": "group",
      "label": { "en": "Energy total" },
      "children": [
        {
          "id": "exclude_grid_exports",
          "type": "checkbox",
          "label": { "en": "Exclude grid exports from Energy total" },
          "hint": { "en": "When enabled, electricity sold back to the grid is not written to the exported counters and so is excluded from Homey's Electricity Total. Toggling this on freezes the exported counter at its last value; toggling off resumes writing the live meter reading." },
          "value": false
        }
      ]
    }
  ]
}
