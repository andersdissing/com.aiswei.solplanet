# Solplanet inverter connection — used by scripts/data-miner.js (and compare.js).
# Copy this file to .env and fill in real values for your inverter.
# The .env file is gitignored and excluded from the Homey app bundle.

SOLPLANET_IP=192.168.1.20
SOLPLANET_SN=ABC1234567

# Optional — defaults shown.
SOLPLANET_INTERVAL=60
SOLPLANET_DURATION=0
SOLPLANET_DEVICE_NR=2
